[Unit]
Description=Octor Seeder Cache Setup (SSD or RAM ext4)
Documentation=Set RAM_CACHE_SIZE in /srv/octor/custom.env to enable RAM mode
Before=octor-torrent-web-seeder.service
After=local-fs.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/srv/octor/scripts/setup-seeder-cache.sh
ExecStop=/srv/octor/scripts/teardown-seeder-cache.sh

[Install]
WantedBy=multi-user.target
