# Fully qualified base URL (includes protocol). Used for link generation.
EXTERNAL_URL=

# List of emails that have access to the /admin control panels.
ADMIN_EMAILS=

# Used by: Vault (Long-term storage) and Torrent-Store (Torrent metainfo cache).
AWS_ACCESS_KEY_ID=

# Used by: Vault (Long-term storage) and Torrent-Store (Torrent metainfo cache).
AWS_SECRET_ACCESS_KEY=

# Used by: Vault (Long-term storage) and Torrent-Store (Torrent metainfo cache).
VAULT_AWS_BUCKET=

# Used by: Vault (Long-term storage) and Torrent-Store (Torrent metainfo cache).
TORRENT_STORE_AWS_BUCKET=

# Used by: Vault (Long-term storage) and Torrent-Store (Torrent metainfo cache).
AWS_POSTER_CACHE_BUCKET=

# PRO TIP: Ensure these match your octor-rclone-mount.service settings.
# VAULT_RCLONE_REMOTE: The remote name in your rclone.conf (e.g., GDrive:, ALPHA_UNION:).
VAULT_RCLONE_REMOTE=

# PRO TIP: Ensure these match your octor-rclone-mount.service settings.
# VAULT_RCLONE_REMOTE: The remote name in your rclone.conf (e.g., GDrive:, ALPHA_UNION:).
