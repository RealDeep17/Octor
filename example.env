# ==============================================================================
# OCTOR CONFIGURATION TEMPLATE (example.env)
# ==============================================================================
# Copy this file to 'custom.env' and fill in your values.
#   cp example.env custom.env
#
# Then start Octor with:
#   ./run.sh start
# ==============================================================================

# ==============================================================================
# TIER 1: CRITICAL SETUP VARIABLES (MUST be filled for Octor to function)
# ==============================================================================
# The operator must explicitly configure these variables. There are no safe
# defaults for these keys, and Octor will not start or function without them.

# Public domain name (e.g. yourname.duckdns.org or a fixed public IP).
DOMAIN=

# Let's Encrypt email address for certbot SSL registrations.
LETSENCRYPT_EMAIL=

# Fully qualified base URL with protocol. Used for link and token generation.
OCTOR_DOMAIN=

# Same as OCTOR_DOMAIN. Used in some downstream contexts.
EXTERNAL_URL=

# Comma-separated list of Google account emails with admin panel access.
ADMIN_EMAILS=

# Secret token required to push magnets into Octor via the Transmission RPC
# emulator endpoint. Set this in your *arr download client configuration.
AUTOMATION_API_KEY=

# Absolute directory path where Sonarr/Radarr/Whisparr database config is stored.
# If running on host (Hybrid), Octor dynamically detects this at '../Big ARRS/config'.
# If running inside Docker (Monolith), this config directory needs to be mounted
# into the container (e.g. at '/config') and mapped below.
OCTOR_ARR_CONFIG_DIR=

# Google OAuth credentials for "Sign in with Google".
# Create at: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# TMDB (The Movie Database) — primary metadata source for mainstream content.
# Acquire a free API key at: https://www.themoviedb.org/
TMDB_API_KEY=
TMDB_API_READ_ACCESS_TOKEN=

# Rclone remote name as defined in your rclone.conf (e.g. ALPHA_UNION:, GDrive:).
# Must match the remote name used in octor-rclone-mount.service.
VAULT_RCLONE_REMOTE=

# Rclone chunker overlay remote (defaults to ALPHA_CHUNKER:).
VAULT_RCLONE_CHUNKER_REMOTE=ALPHA_CHUNKER:

# Rclone S3 union gateway remote (defaults to ALPHA_UNION:).
VAULT_RCLONE_S3_REMOTE=ALPHA_UNION:

# Absolute path to your rclone.conf file on the host.
VAULT_RCLONE_CONFIG=

# Random secret used to sign session tokens. Use a strong random string.
SESSION_SECRET=


# ==============================================================================
# TIER 2: STANDARD PREFILLED DEFAULTS (Ready to use out-of-the-box)
# ==============================================================================
# These variables are prepopulated with standard local database credentials,
# directory mount paths, ports, and recommended performance defaults.
# You can leave these as-is unless your infrastructure layout differs.

# --- 📂 RCLONE STORAGE MOUNTS & VFS CACHE (Most Important Settings) ---
# Path where the rclone VFS/chunker mount is exposed on the host filesystem.
# Automatically updated by './run.sh mode' when switching storage modes.
# Non-chunker (sp-*) modes: points to drive-mount-vfs
# Chunker (pp-*) modes:     points to drive-mount (chunker overlay)
VAULT_STORAGE_PATH=__PROJECT_ROOT__/infra-data/drive-mount-vfs

# Path the custom S3 gateway uses as its storage root.
# Should match VAULT_STORAGE_PATH. Also auto-updated by './run.sh mode'.
S3_GATEWAY_STORAGE_DIR=__PROJECT_ROOT__/infra-data/drive-mount-vfs

# Where rclone caches VFS metadata and file blocks on local disk.
RCLONE_CACHE_DIR=/mnt/seeder-cache/rclone-vfs

# Maximum size of rclone's VFS cache on disk.
# Prefilled at 100G for standard servers to avoid filling local disk (down from 500G).
RCLONE_VFS_CACHE_MAX_SIZE=100G

# VFS cache settings — auto-updated by './run.sh mode'.
RCLONE_VFS_CACHE_MODE=writes
RCLONE_VFS_CACHE_MAX_AGE=1h
RCLONE_VFS_CACHE_POLL_INTERVAL=1h

# Rclone performance tuning — tuned for normal/moderate server memory bounds.
RCLONE_BUFFER_SIZE=64M
RCLONE_DRIVE_CHUNK_SIZE=128M
RCLONE_CHUNKER_CHUNK_SIZE=1G
RCLONE_TRANSFERS=2

# --- ⚙️ PERFORMANCE & CACHE ARCHITECTURE ---
# Performance mode profile (automatically updated by run.sh mode):
#   - SSD Single Part - Cache Off   (sp-perf-ssd, sp-eco-ssd): Low RAM, sequential upload, safe single files. Small storage friendly. Default.
#   - RAM Single Part - Cache Off   (sp-perf-ram, sp-eco-ram): Saves SSD life, sequential upload, safe single files. Small storage friendly.
#   - SSD Single Part - Cache Write (sp-write-perf-ssd, sp-write-eco-ssd): Parallel upload (Single Part). Requires local cache space > largest file.
#   - RAM Parallel Part - Chunker   (pp-perf-ram, pp-eco-ram): Parallel upload (Parallel Part), nested mount, split files. Small storage friendly.
#   - SSD Parallel Part - Chunker   (pp-perf-ssd, pp-eco-ssd): Parallel upload (Parallel Part), nested mount, split files. Small storage friendly.
# Default is: sp-perf-ssd (non-chunker-vfs-ssd)
OCTOR_PERFORMANCE_MODE=non-chunker-vfs-ssd

# Set to true for RAM-backed seeder cache (ext4 loopback). false = SSD mode.
RAM_CACHE_ENABLED=false

# Size of the in-memory ext4 loopback image (RAM mode only). e.g. 12288M.
RAM_CACHE_SIZE=12288M

# Size limit for the backing tmpfs (must be >= RAM_CACHE_SIZE). e.g. 17G.
TMPFS_SIZE=17G

# Max local cache per torrent before LRU eviction triggers.
PER_TORRENT_CACHE_BUDGET=10000M

# SSD fallback directory when RAM_CACHE_ENABLED=false.
SSD_DATA_DIR=__PROJECT_ROOT__/infra-data/seeder-cache

# Active seeder cache path. setup-seeder-cache.sh sets this as RAM mount or SSD symlink.
DATA_DIR=/mnt/seeder-cache

# BadgerDB path for high-speed torrent piece hash storage.
BADGER_PATH=__PROJECT_ROOT__/infra-data/badger

# BadgerDB TTL in seconds. 31536000 = 1 year.
BADGER_EXPIRE=31536000

# How long inactive media stays in seeder cache before the cleaner removes it.
CACHED_MEDIA_MAX_AGE=23h

# How often the cleaner runs to free up seeder cache space.
CACHED_MEDIA_CLEAN_INTERVAL=5m

# How long enriched metadata (TMDB/sidecar results) is cached in Redis.
CACHED_METADATA_EXPIRE=30m

# How long catalog index responses are cached.
CACHE_INDEX_EXPIRE=23h

# How long the sidecar enrichment cache TTL lasts (in days).
ENRICH_CACHE_TTL_DAYS=30

# --- 💽 POSTGRESQL DATABASE DETAILS ---
# The init-db.sql script creates all required databases on first boot.
# Used by: rest-api, vault, abuse-store, url-store, claims-provider.
POSTGRES_USER=octor
POSTGRES_PASSWORD=octor
POSTGRES_DB=octor
# Database connection host and port.
# If running inside Docker (Monolith), these are overridden to container defaults (octor-postgres:5432).
# If running directly on the host (Hybrid), set to localhost and 5433 (or whatever port you mapped).
POSTGRES_HOST=localhost
POSTGRES_PORT=5433

# Legacy aliases kept for compatibility with older service configs.
PG_USER=octor
PG_PASSWORD=octor
PG_DATABASE=octor
PG_HOST=localhost
PG_PORT=5433

# --- ☁️ BUILT-IN S3 GATEWAY CREDENTIALS ---
# S3-compatible credentials used by Vault (long-term storage) and Torrent-Store.
AWS_ACCESS_KEY_ID=octoradmin
AWS_SECRET_ACCESS_KEY=octorpassword

# Bucket names for each storage subsystem.
VAULT_AWS_BUCKET=vault
TORRENT_STORE_AWS_BUCKET=torrent-store
AWS_POSTER_CACHE_BUCKET=poster-cache

# S3 endpoint URL. For the built-in gateway: http://localhost:9000
AWS_ENDPOINT=http://localhost:9000
# S3 region (use any value for the built-in gateway, e.g. us-east-1).
AWS_REGION=us-east-1
# Set to true when using the built-in HTTP gateway (no TLS).
AWS_NO_SSL=true

# --- 🔍 PROWLARR & METADATA DEFAULTS ---
# Prowlarr connection details for the Direct Search feature (Required for Indexer).
PROWLARR_URL=http://localhost:9696/prowlarr
PROWLARR_API_KEY=

# Radarr, Sonarr, Whisparr API Keys (Optional, default to integrated if provided).
RADARR_API_KEY=
SONARR_API_KEY=
WHISPARR_API_KEY=

# Optional RuTracker Credentials (for Prowlarr Indexer Bootstrapping)
RUTRACKER_USER=
RUTRACKER_PASS=

# TMDB Host overrides (defaulting to standard)
TMDB_API_HOST=api.tmdb.org
TMDB_API_PORT=443
TMDB_API_SECURE=true
TMDB_IMAGE_BASE_URL=https://image.tmdb.org/t/p

# OMDB / Python Sidecar — secondary source for adult, obscure, and fallback content.
# Points to the local sidecar service (octor-sidecar on port 8000).
OMDB_API_KEY=
OMDB_API_HOST=localhost
OMDB_API_PORT=8000
OMDB_API_SECURE=false

# StashDB & ThePornDB API keys — used by the sidecar for adult scene lookups.
STASHDB_API_KEY=
THEPORNDB_API_KEY=

# Kinopoisk Unofficial API — tertiary source for Russian/foreign content.
KINOPOISK_UNOFFICIAL_API_KEY=
KINOPOISK_UNOFFICIAL_API_HOST=kinopoiskapiunofficial.tech
KINOPOISK_UNOFFICIAL_API_PORT=443
KINOPOISK_UNOFFICIAL_API_SECURE=true

# Anthropic-compatible API key and base URL.
# ANTHROPIC_BASE_URL points to the local ai-proxy (proxy.js) which translates
# Anthropic API calls to Gemini. Keep the base URL as the local proxy address.
ANTHROPIC_API_KEY=sk-ant-proxy-gemini
ANTHROPIC_BASE_URL=http://127.0.0.1:3456

# AI-powered discovery recommendations on the Discover page.
AI_RECOMMENDATIONS_ENABLED=true
AI_RECOMMENDATIONS_MODEL=gemini-3.1-flash-lite

# AI-powered metadata enrichment (fills missing titles, descriptions, genres).
AI_ENRICH_ENABLED=true
AI_ENRICH_MODEL=gemini-3.1-flash
AI_ENRICH_TIMEOUT_SECONDS=30
AI_ENRICH_MAX_CANDIDATES=3

# --- 🔌 INTERNAL MICROSERVICE ROUTING (Rarely Changed) ---
# NATS JetStream — used for real-time events between microservices.
NATS_HOST=octor-nats
NATS_PORT=4222
NATS_SERVICE_HOST=octor-nats
NATS_SERVICE_PORT=4222

# Redis — used by video-info, content-prober, and Web UI sessions.
REDIS_HOST=octor-redis
REDIS_PORT=6379
REDIS_SERVICE_HOST=octor-redis
REDIS_SERVICE_PORT=6379
REDIS_MASTER_SERVICE_HOST=octor-redis
REDIS_MASTER_SERVICE_PORT=6379

# Internal API keys — must be identical across all services.
OCTOR_API_KEY=octor-internal-api-key
OCTOR_API_SECRET=octor-internal-api-secret
EXPORT_API_KEY=octor-internal-api-key
EXPORT_API_SECRET=octor-internal-api-secret
API_KEY=octor-internal-api-key
API_SECRET=octor-internal-api-secret

# REST API — central hub for all client and inter-service requests.
REST_API_SERVICE_HOST=localhost
REST_API_SERVICE_PORT=8080
REST_API_SECURE=false

# Torrent Web Seeder — streams torrent data to clients.
TORRENT_WEB_SEEDER_SERVICE_HOST=127.0.0.1
TORRENT_WEB_SEEDER_SERVICE_PORT=50054

# Content Transcoder — HLS/audio transcoding for browser compatibility.
CONTENT_TRANSCODER_SERVICE_HOST=127.0.0.1
CONTENT_TRANSCODER_SERVICE_PORT=50055

# Video Info — extracts codec, duration, resolution metadata.
VIDEO_INFO_SERVICE_HOST=127.0.0.1
VIDEO_INFO_SERVICE_PORT=50056

# Torrent Archiver — archives torrent metainfo files.
TORRENT_ARCHIVER_SERVICE_HOST=127.0.0.1
TORRENT_ARCHIVER_SERVICE_PORT=50057

# SRT2VTT — converts subtitle files to WebVTT for browser playback.
SRT2VTT_SERVICE_HOST=127.0.0.1
SRT2VTT_SERVICE_PORT=50058

# Content Prober — probes media files for technical metadata.
CONTENT_PROBER_SERVICE_HOST=127.0.0.1
CONTENT_PROBER_SERVICE_PORT=50063
CONTENT_PROBER_HTTP_SERVICE_HOST=127.0.0.1
CONTENT_PROBER_HTTP_SERVICE_PORT=50062

# Vault — manages long-term storage pledging and retrieval.
VAULT_SERVICE_HOST=127.0.0.1
VAULT_SERVICE_PORT=8086

# Legacy safety only; web-ui proto packages are namespaced.
GOLANG_PROTOBUF_REGISTRATION_CONFLICT=ignore

# Gin web framework mode. 'release' disables debug logging.
GIN_MODE=release

# Subdomains/routing defaults.
EXPORT_USE_SUBDOMAINS=false
AUTOMATION_AUTO_VAULT=true

# Internal torrent proxy config
USE_INTERNAL_TORRENT_HTTP_PROXY=true
TORRENT_HTTP_PROXY_SERVICE_HOST=127.0.0.1
TORRENT_HTTP_PROXY_SERVICE_PORT=50052

# S3 Gateway Performance defaults
S3_GATEWAY_WRITE_BUFFER_SIZE=
S3_GATEWAY_TEMP_UPLOADS_DIR=/mnt/seeder-cache/s3-gateway-uploads
S3_GATEWAY_MAX_STAGING_SIZE=
S3_GATEWAY_HUMAN_READABLE=false

# Enable the Python sidecar for adult/obscure metadata enrichment.
SIDECAR_ENRICHMENT_ENABLED=true

# Torrent peer connection limits — tuned down for standard/normal server limits.
ESTABLISHED_CONNS_PER_TORRENT=150
HALF_OPEN_CONNS_PER_TORRENT=75
TOTAL_HALF_OPEN_CONNS=150
MAX_UNVERIFIED_BYTES=100MB
MAX_READAHEAD=256M
PIECE_HASHERS_PER_TORRENT=4

# Number of vault worker goroutines that poll/claim queue jobs.
# Adjusted down to 20 for standard server resources (down from 100).
WORKERS=20

# Max simultaneous vault jobs (torrent → S3/Drive uploads).
# Adjusted down to 10 for standard server resources (down from 50).
VAULT_MAX_CONCURRENT_JOBS=10

# Number of parallel workers uploading parts to S3/Drive.
AWS_UPLOAD_CONCURRENCY=1
AWS_UPLOAD_PART_SIZE=33554432

# Authentication settings
SUPERTOKENS_SERVICE_HOST=https://try.supertokens.com
SUPERTOKENS_SERVICE_PORT=443
ENFORCE_SESSION_IP=false


