# ==============================================================================
# OCTOR CONFIGURATION TEMPLATE (example.env)
# ==============================================================================
# Copy this file to 'custom.env' and fill in your values.
#   cp example.env custom.env
#
# Then start Octor with:
#   ./run.sh start
#
# Sections:
#   1. Critical Setup        — required for Octor to function
#   2. API Keys              — metadata and AI enrichment
#   3. Authentication        — Google OAuth, SuperTokens
#   4. Storage & Performance — cache, RAM/SSD modes, rclone tuning
#   5. Internal Routing      — microservice hostnames & ports (rarely changed)
#   6. Discovery Engine      — Prowlarr + automation ingest
# ==============================================================================


# ------------------------------------------------------------------------------
# 1. 🛑 CRITICAL SETUP (Required)
# ------------------------------------------------------------------------------

# Public domain name (e.g. yourname.duckdns.org or a fixed IP).
DOMAIN=

# Fully qualified base URL with protocol. Used for link and token generation.
OCTOR_DOMAIN=

# Same as OCTOR_DOMAIN. Used in some downstream contexts.
EXTERNAL_URL=

# Comma-separated list of Google account emails with admin panel access.
ADMIN_EMAILS=

# S3-compatible credentials used by Vault (long-term storage) and Torrent-Store.
# For the built-in S3 gateway (octor-s3-gateway), use any non-empty value.
# For an external S3/MinIO endpoint, use real credentials.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Bucket names for each storage subsystem.
VAULT_AWS_BUCKET=vault
TORRENT_STORE_AWS_BUCKET=torrent-store
AWS_POSTER_CACHE_BUCKET=poster-cache

# Rclone remote name as defined in your rclone.conf (e.g. ALPHA_UNION:, GDrive:).
# Must match the remote used in octor-rclone-mount.service.
VAULT_RCLONE_REMOTE=

# Absolute path to your rclone.conf file.
VAULT_RCLONE_CONFIG=

# Path where the rclone VFS/chunker mount is exposed on the host filesystem.
# Automatically updated by './run.sh mode' when switching storage modes.
# Non-chunker (sp-*) modes: points to drive-mount-vfs
# Chunker (pp-*) modes:     points to drive-mount (chunker overlay)
VAULT_STORAGE_PATH=

# Path the custom S3 gateway uses as its storage root.
# Should match VAULT_STORAGE_PATH. Also auto-updated by './run.sh mode'.
S3_GATEWAY_STORAGE_DIR=

# PostgreSQL connection details.
# The init-db.sql script creates all required databases on first boot.
# Used by: rest-api, vault, abuse-store, url-store, claims-provider.
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
POSTGRES_HOST=
POSTGRES_PORT=

# Legacy aliases kept for compatibility with older service configs.
PG_USER=
PG_PASSWORD=
PG_DATABASE=
PG_HOST=
PG_PORT=

# Legacy / no longer required on fixed-IP or non-DuckDNS setups.
# Keep empty if unused.
SUDO_PASSWORD=
DUCKDNS_TOKEN=


# ------------------------------------------------------------------------------
# 2. ⚙️ API KEYS (Recommended)
# ------------------------------------------------------------------------------

# TMDB (The Movie Database) — primary metadata source for mainstream content.
TMDB_API_KEY=
TMDB_API_READ_ACCESS_TOKEN=
TMDB_API_HOST=api.themoviedb.org
TMDB_API_PORT=443
TMDB_API_SECURE=true
TMDB_IMAGE_BASE_URL=https://image.tmdb.org/t/p

# OMDB / Python Sidecar — secondary source for adult, obscure, and fallback content.
# Points to the local sidecar service (octor-sidecar on port 8000).
OMDB_API_KEY=
OMDB_API_HOST=localhost
OMDB_API_PORT=8000
OMDB_API_SECURE=false

# StashDB API key — used by the sidecar for adult scene lookups.
STASHDB_API_KEY=

# ThePornDB API key — used by the sidecar for adult content metadata.
THEPORNDB_API_KEY=

# Kinopoisk Unofficial API — tertiary source for Russian/foreign content.
KINOPOISK_UNOFFICIAL_API_KEY=
KINOPOISK_UNOFFICIAL_API_HOST=kinopoiskapiunofficial.tech
KINOPOISK_UNOFFICIAL_API_PORT=443
KINOPOISK_UNOFFICIAL_API_SECURE=true

# Gemini API key — used for AI recommendations and metadata enrichment fallbacks.
GEMINI_API_KEY=

# Anthropic-compatible API key and base URL.
# ANTHROPIC_BASE_URL points to the local ai-proxy (proxy.js) which translates
# Anthropic API calls to Gemini. Keep the base URL as the local proxy address.
ANTHROPIC_API_KEY=sk-ant-proxy-gemini
ANTHROPIC_BASE_URL=http://127.0.0.1:3456

# AI-powered discovery recommendations on the Discover page.
AI_RECOMMENDATIONS_ENABLED=false
AI_RECOMMENDATIONS_MODEL=

# AI-powered metadata enrichment (fills missing titles, descriptions, genres).
AI_ENRICH_ENABLED=false
AI_ENRICH_MODEL=
AI_ENRICH_TIMEOUT_SECONDS=30
AI_ENRICH_MAX_CANDIDATES=3


# ------------------------------------------------------------------------------
# 3. 🔒 AUTHENTICATION & SECURITY
# ------------------------------------------------------------------------------

# Google OAuth credentials for "Sign in with Google".
# Create at: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Patreon OAuth (legacy / optional).
PATREON_CLIENT_ID=
PATREON_CLIENT_SECRET=

# SuperTokens identity service. Use the free managed tier (try.supertokens.com)
# or self-host. See: https://supertokens.com
SUPERTOKENS_SERVICE_HOST=https://try.supertokens.com
SUPERTOKENS_SERVICE_PORT=443

# Random secret used to sign session tokens. Use a strong random string.
SESSION_SECRET=

# If true, sessions are pinned to the client IP. Adds security, breaks mobile roaming.
ENFORCE_SESSION_IP=false


# ------------------------------------------------------------------------------
# 4. 🛠️ STORAGE & PERFORMANCE
# ------------------------------------------------------------------------------

# ⚠️  CHUNKER MODE WARNING:
#   Files uploaded in Chunker (pp-*) modes are split into .001/.002/... slices.
#   Switching to Non-Chunker (sp-*) mode makes those files appear fragmented
#   and UNPLAYABLE. Only switch modes if you understand the consequences.
#   Use './run.sh mode' to switch safely — it warns you before changing.
#
# Valid values set automatically by './run.sh mode':
#   chunker-vfs-ram, chunker-vfs-ssd, non-chunker-vfs-ram, non-chunker-vfs-ssd
OCTOR_PERFORMANCE_MODE=

# Set to true for RAM-backed seeder cache (ext4 loopback). false = SSD mode.
RAM_CACHE_ENABLED=true

# Size of the in-memory ext4 loopback image (RAM mode only). e.g. 8192M, 10G.
RAM_CACHE_SIZE=

# Size limit for the backing tmpfs (must be >= RAM_CACHE_SIZE). e.g. 15G.
TMPFS_SIZE=

# Max local cache per torrent before LRU eviction triggers. e.g. 2000M.
# Formula: VAULT_MAX_CONCURRENT_JOBS × PER_TORRENT_CACHE_BUDGET ≈ peak RAM.
PER_TORRENT_CACHE_BUDGET=

# SSD fallback directory when RAM_CACHE_ENABLED=false.
SSD_DATA_DIR=

# Active seeder cache path. setup-seeder-cache.sh sets this as RAM mount or SSD symlink.
DATA_DIR=

# BadgerDB path for high-speed torrent piece hash storage.
BADGER_PATH=

# BadgerDB TTL in seconds. 31536000 = 1 year.
BADGER_EXPIRE=31536000

# How long inactive media stays in seeder cache before the cleaner removes it.
CACHED_MEDIA_MAX_AGE=23h

# How often the cleaner runs to free up seeder cache space.
CACHED_MEDIA_CLEAN_INTERVAL=5m

# How long enriched metadata (TMDB/sidecar results) is cached in Redis.
CACHED_METADATA_EXPIRE=30m

# How long catalog index responses are cached.
CACHE_INDEX_EXPIRE=23h

# How long the sidecar enrichment cache TTL lasts (in days).
ENRICH_CACHE_TTL_DAYS=30

# Number of vault worker goroutines that poll/claim queue jobs.
# This is separate from VAULT_MAX_CONCURRENT_JOBS, which caps active uploads.
# Keep WORKERS >= VAULT_MAX_CONCURRENT_JOBS so deletes/retries stay responsive.
WORKERS=

# Max simultaneous vault jobs (torrent → S3/Drive uploads).
# 0 = unlimited. Recommended: 2–4 to avoid RAM exhaustion.
VAULT_MAX_CONCURRENT_JOBS=3

# Sequential write buffer bridging the seeder and S3/Drive upload (bytes).
# e.g. 33554432 = 32MB. Increase for high-latency Drive connections.
S3_GATEWAY_WRITE_BUFFER_SIZE=

# Temporary directory for in-flight multipart S3 parts.
# Use a path inside the RAM disk for zero SSD wear.
S3_GATEWAY_TEMP_UPLOADS_DIR=

# Maximum bytes of unstaged upload data allowed in RAM before backpressure.
# Default: 536870912 (512MB).
S3_GATEWAY_MAX_STAGING_SIZE=

# ⚠️  HUMAN_READABLE WARNING:
#   If true, files are stored with human-readable torrent names instead of hashes.
#   This BREAKS deduplication and prevents streaming/downloads by hash.
#   Keep false unless you have a specific reason.
S3_GATEWAY_HUMAN_READABLE=false

# Number of parallel workers uploading parts to S3/Drive.
AWS_UPLOAD_CONCURRENCY=

# Multipart part size in bytes. e.g. 33554432 = 32MB. Larger = fewer requests to Drive.
AWS_UPLOAD_PART_SIZE=

# S3 endpoint URL. For the built-in gateway: http://localhost:9000
AWS_ENDPOINT=

# S3 region (use any value for the built-in gateway, e.g. us-east-1).
AWS_REGION=us-east-1

# Set to true when using the built-in HTTP gateway (no TLS).
AWS_NO_SSL=true

# If false (recommended): video stream is direct-copied, audio is transcoded to AAC.
#   Supports DTS/TrueHD audio on all browsers with minimal CPU.
# If true: zero CPU, but MKV containers and DTS audio will not work in browsers.
FORCE_DIRECT_PLAY=false

# Where rclone caches VFS metadata and file blocks.
# In RAM mode, should be inside DATA_DIR (e.g. /mnt/seeder-cache/rclone-vfs).
RCLONE_CACHE_DIR=

# VFS cache settings — auto-updated by './run.sh mode'.
RCLONE_VFS_CACHE_MAX_SIZE=off
RCLONE_VFS_CACHE_MODE=off
RCLONE_VFS_CACHE_MAX_AGE=1h
RCLONE_VFS_CACHE_POLL_INTERVAL=1h

# Rclone performance tuning — auto-updated by './run.sh mode'.
RCLONE_BUFFER_SIZE=128M
RCLONE_DRIVE_CHUNK_SIZE=256M
RCLONE_TRANSFERS=2

# Enable the Python sidecar for adult/obscure metadata enrichment.
SIDECAR_ENRICHMENT_ENABLED=true

# Age threshold (days) for background metadata refresh job.
ENRICH_REFRESH_DAYS=7

# Number of concurrent background enrichment workers.
ENRICH_CONCURRENCY=5

# Torrent peer connection limits — tuned for high-bandwidth servers (1Gbps+).
# Reduce on low-bandwidth hosts to avoid connection exhaustion.
ESTABLISHED_CONNS_PER_TORRENT=300
HALF_OPEN_CONNS_PER_TORRENT=150
TORRENT_PEERS_HIGH_WATER=600
TORRENT_PEERS_LOW_WATER=300
TOTAL_HALF_OPEN_CONNS=300
DIAL_RATE_LIMIT=150
MAX_UNVERIFIED_BYTES=100MB
MAX_READAHEAD=256M
PIECE_HASHERS_PER_TORRENT=4


# ------------------------------------------------------------------------------
# 5. 🔌 INTERNAL MICROSERVICE ROUTING (Rarely Changed)
# ------------------------------------------------------------------------------

# NATS JetStream — used for real-time events between microservices.
NATS_HOST=127.0.0.1
NATS_PORT=4222
NATS_SERVICE_HOST=127.0.0.1
NATS_SERVICE_PORT=4222

# Redis — used by video-info, content-prober, and Web UI sessions.
# Host port 6380 maps to Docker container's 6379.
REDIS_HOST=127.0.0.1
REDIS_PORT=6380
REDIS_SERVICE_HOST=127.0.0.1
REDIS_SERVICE_PORT=6380
REDIS_MASTER_SERVICE_HOST=127.0.0.1
REDIS_MASTER_SERVICE_PORT=6380

# Internal API keys — must be identical across all services.
# Used to sign and verify playback/download tokens.
OCTOR_API_KEY=
OCTOR_API_SECRET=
EXPORT_API_KEY=
EXPORT_API_SECRET=
API_KEY=
API_SECRET=

# REST API — central hub for all client and inter-service requests.
REST_API_SERVICE_HOST=localhost
REST_API_SERVICE_PORT=8080
REST_API_SECURE=false

# Torrent Web Seeder — streams torrent data to clients.
TORRENT_WEB_SEEDER_SERVICE_HOST=127.0.0.1
TORRENT_WEB_SEEDER_SERVICE_PORT=50054

# Content Transcoder — HLS/audio transcoding for browser compatibility.
CONTENT_TRANSCODER_SERVICE_HOST=127.0.0.1
CONTENT_TRANSCODER_SERVICE_PORT=50055

# Video Info — extracts codec, duration, resolution metadata.
VIDEO_INFO_SERVICE_HOST=127.0.0.1
VIDEO_INFO_SERVICE_PORT=50056

# Torrent Archiver — archives torrent metainfo files.
TORRENT_ARCHIVER_SERVICE_HOST=127.0.0.1
TORRENT_ARCHIVER_SERVICE_PORT=50057

# SRT2VTT — converts subtitle files to WebVTT for browser playback.
SRT2VTT_SERVICE_HOST=127.0.0.1
SRT2VTT_SERVICE_PORT=50058

# Content Prober — probes media files for technical metadata.
CONTENT_PROBER_SERVICE_HOST=127.0.0.1
CONTENT_PROBER_SERVICE_PORT=50063
CONTENT_PROBER_HTTP_SERVICE_HOST=127.0.0.1
CONTENT_PROBER_HTTP_SERVICE_PORT=50062

# Vault — manages long-term storage pledging and retrieval.
VAULT_SERVICE_HOST=127.0.0.1
VAULT_SERVICE_PORT=8086

# Legacy safety only; web-ui proto packages are namespaced and should not require this.
GOLANG_PROTOBUF_REGISTRATION_CONFLICT=ignore

# Gin web framework mode. 'release' disables debug logging.
GIN_MODE=release

# If true, export links use subdomains (e.g. <hash>.octor.duckdns.org).
# Requires wildcard DNS and reverse proxy configured for subdomains.
EXPORT_USE_SUBDOMAINS=false


# ------------------------------------------------------------------------------
# 6. 🔍 DISCOVERY ENGINE (Prowlarr & Automation Ingest)
# ------------------------------------------------------------------------------

# Secret token required to push magnets into Octor via the Transmission RPC
# emulator endpoint. Set this in your *arr download client configuration.
AUTOMATION_API_KEY=

# If true, torrents pushed via the Transmission RPC emulator are automatically
# queued for vault storage after being added to the library.
# Can be toggled live in Admin → Settings without restarting.
AUTOMATION_AUTO_VAULT=false

# Prowlarr connection details for the Direct Search feature.
PROWLARR_URL=
PROWLARR_API_KEY=

# ------------------------------------------------------------------------------
# 8. ⚙️ ADVANCED OPTIONAL SERVICE KNOBS
# ------------------------------------------------------------------------------
# These are supported by the binaries but are usually safe to leave at defaults.
# Uncomment only when tuning a specific subsystem.

# Prowlarr: return only magnet links from search results when possible.
PROWLARR_MAGNET_ONLY=false

# Torrent HTTP proxy: enable per-user bandwidth limits. Self-host default is off.
USE_BANDWIDTH_LIMIT=false

# Torrent HTTP proxy: optional ClickHouse request statistics sink.
# CLICKHOUSE_DSN=
# CLICKHOUSE_BATCH_SIZE=1000
# CLICKHOUSE_REPLICATED=false
# CLICKHOUSE_SHARDED=false

# Claims provider: cache/store behavior for member claims lookup.
# STORE_CACHE_CONCURRENCY=10
# STORE_CACHE_EXPIRE=60s
# STORE_CACHE_ERROR_EXPIRE=10s
# STORE_CACHE_CAPACITY=1000
# STORE_DB_TIMEOUT=5s

