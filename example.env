# AI_RECOMMENDATIONS_PAID_MODEL=
# AI_RECOMMENDATIONS_CHIPS_MODEL=
# AI_RECOMMENDATIONS_FREE_DAILY_QUOTA=20
# AI_RECOMMENDATIONS_PAID_DAILY_QUOTA=200
# AI_RECOMMENDATIONS_HISTORY_LIMIT=50
# AI_RECOMMENDATIONS_MAX_QUERY_LENGTH=500
