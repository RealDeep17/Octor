# ------------------------------------------------------------------------------
# 6. 🔍 DISCOVERY ENGINE (Prowlarr & Automation Ingestion)
# ------------------------------------------------------------------------------
AUTOMATION_API_KEY=

# When true, torrents pushed via the Transmission RPC emulator (Autobrr, *arr stack) are
# automatically queued for vault storage after being added to your library.
# Can be overridden at runtime without a restart via Admin → Settings toggle.
AUTOMATION_AUTO_VAULT=false

PROWLARR_URL=
PROWLARR_API_KEY=

