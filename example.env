# ==============================================================================
# OCTOR COMPREHENSIVE CONFIGURATION FILE
# ==============================================================================
# This file is your single source of truth for all configurations in the Octor platform.
# It controls databases, caching rules, domain routing, API keys, and microservices.
# 
# Instructions:
# 1. Copy this file to 'custom.env'
# 2. Modify 'custom.env' with your real credentials (it is gitignored)
# 3. run_dev.sh will automatically load from 'custom.env'
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. INFRASTRUCTURE & DATABASES
# ------------------------------------------------------------------------------
# These settings tell the Octor microservices where to find your core infrastructure.

# Postgres Configuration (Used by Rest-API, Vault, Abuse-Store, URL-Store)
POSTGRES_USER=webtor
POSTGRES_PASSWORD=webtor
POSTGRES_DB=webtor
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5433

# Redis Configuration (Used for ephemeral caching, queue management, and video-info)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# NATS Message Broker (Used for high-speed pub/sub events between microservices)
NATS_HOST=127.0.0.1
NATS_PORT=4222

# S3 / MinIO Object Storage (Used by Vault to store files and Torrent-Store to cache pieces)
AWS_ENDPOINT=http://localhost:9000
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=octoradmin
AWS_SECRET_ACCESS_KEY=octorpassword
VAULT_AWS_BUCKET=vault
TORRENT_STORE_AWS_BUCKET=torrent-store
AWS_NO_SSL=true

# ------------------------------------------------------------------------------
# 2. DOMAIN & CORE ROUTING
# ------------------------------------------------------------------------------
# Controls how the application is accessed from the outside world.

# DOMAIN: The base domain for the frontend web-ui.
DOMAIN=localhost:8081

# OCTOR_DOMAIN: The fully qualified URL used for internal linking and callbacks.
OCTOR_DOMAIN=http://localhost:8081

# EXTERNAL_URL: Used by the REST API for creating shareable links or external embeds.
EXTERNAL_URL=http://localhost:8081

# EXPORT_USE_SUBDOMAINS: If true, creates unique subdomains for media exports (e.g. video1.octor.com)
EXPORT_USE_SUBDOMAINS=false

# ------------------------------------------------------------------------------
# 3. WEBTOR MAIN REST API
# ------------------------------------------------------------------------------
# The primary API that the Web UI and external apps communicate with.
REST_API_SERVICE_HOST=localhost
REST_API_SERVICE_PORT=8080
REST_API_SECURE=false

# ------------------------------------------------------------------------------
# 4. CACHING & STORAGE LIMITS (PERFORMANCE TUNING)
# ------------------------------------------------------------------------------
# These settings are critical for managing your disk space and RAM usage.

# BadgerDB Local Storage Path (High-speed key-value store for torrent metadata)
BADGER_PATH=./badger-data

# Badger Cache TTL: How long torrent pieces live in BadgerDB. (0 = forever, 604800 = 7 days)
BADGER_EXPIRE=604800

# Media Cache: Controls the actual media files downloaded by torrent-web-seeder into DATA_DIR.
# If you have limited disk space, keep this low (e.g., 24h). The cleaner job runs every 5m.
CACHED_MEDIA_MAX_AGE=23h
CACHED_MEDIA_CLEAN_INTERVAL=5m

# Metadata Cache: How long we cache list responses, OMDB lookups, and torrent info hashes.
CACHED_METADATA_EXPIRE=30m
CACHED_TEMP_EXPIRE=2m

# Cache Index Expire: How long Postgres remembers that a media file exists locally before re-checking.
CACHE_INDEX_EXPIRE=23h

# Optimization: If true, forces direct video play instead of transcoding (can save CPU but breaks some browsers).
FORCE_DIRECT_PLAY=true

# --- Seeder Cache Mode Toggle ---
# If true: Mounts a RAM disk at DATA_DIR. Extremely fast, zero SSD wear.
# If false: Symlinks DATA_DIR to SSD_DATA_DIR. Persistent, survives reboots.
RAM_CACHE_ENABLED=true
OCTOR_PERFORMANCE_MODE=chunker-vfs-ram

# --- RAM Mode Config ---
RAM_CACHE_SIZE=3500M
TMPFS_SIZE=10G

# --- SSD Mode Config ---
SSD_DATA_DIR=/srv/octor/infra-data/seeder-cache

# --- UNIVERSAL DATA_DIR ---
DATA_DIR=/mnt/seeder-cache

# Max local SSD/RAM space per torrent. Triggers LRU eviction if exceeded.
PER_TORRENT_CACHE_BUDGET=1500M

# --- S3 Gateway sequential write buffer in RAM ---
S3_GATEWAY_WRITE_BUFFER_SIZE=33554432
S3_GATEWAY_TEMP_UPLOADS_DIR=/mnt/seeder-cache/s3-gateway-uploads
S3_GATEWAY_MAX_STAGING_SIZE=536870912
AWS_UPLOAD_CONCURRENCY=1
AWS_UPLOAD_PART_SIZE=33554432

# --- Remote Drive Integration (Rclone) ---
VAULT_RCLONE_REMOTE=ALPHA_UNION:
VAULT_RCLONE_CONFIG=/home/ubuntu/.config/rclone/rclone.conf

VAULT_STORAGE_PATH=/srv/octor/infra-data/drive-mount
S3_GATEWAY_STORAGE_DIR=/srv/octor/infra-data/drive-mount

# Dynamic cache dir: stores VFS cache inside RAM disk when RAM_CACHE_ENABLED=true!
RCLONE_CACHE_DIR=/mnt/seeder-cache/rclone-vfs

# Dynamic VFS Cache limits:
RCLONE_VFS_CACHE_MAX_SIZE=2G
RCLONE_VFS_CACHE_MODE=writes
RCLONE_VFS_CACHE_MAX_AGE=1h
RCLONE_VFS_CACHE_POLL_INTERVAL=1s

# Centralized Low-RAM parameters (75% RAM reduction, 19% write speedup!)
RCLONE_BUFFER_SIZE=32M
RCLONE_DRIVE_CHUNK_SIZE=128M
RCLONE_TRANSFERS=4

# ------------------------------------------------------------------------------
# 5. METADATA & ENRICHMENT (PRIMARY, SECONDARY, AND TERTIARY DATABASES)
# ------------------------------------------------------------------------------
# The Octor platform queries multiple metadata databases in a fallback chain to 
# enrich raw media files (giving them posters, descriptions, ratings).
# Fallback Chain: TMDB (Primary) -> OMDB/Sidecar (Secondary) -> Kinopoisk (Tertiary)

# Enable or disable the entire enrichment pipeline.
SIDECAR_ENRICHMENT_ENABLED=true

# [PRIMARY] TMDB (The Movie Database) - Mainstream Movies & TV Shows
TMDB_API_HOST=api.themoviedb.org
TMDB_API_PORT=443
TMDB_API_SECURE=true
TMDB_API_KEY=
TMDB_IMAGE_BASE_URL=https://image.tmdb.org/t/p

# [SECONDARY] OMDB / Python Sidecar - Adult, Obscure, & Fallback Metadata
# The python 'sidecar' acts as a proxy for the OMDB API interface, but actually
# delegates requests to adult metadata DBs when TMDB returns nothing.
OMDB_API_HOST=localhost
OMDB_API_PORT=8000
OMDB_API_SECURE=false
OMDB_API_KEY=1799aaa7

# Sidecar Target DBs: Keys required by the Python Sidecar to perform its lookups.
STASHDB_API_KEY=
THEPORNDB_API_KEY=

# [TERTIARY] Kinopoisk Unofficial - Russian / Foreign Content Fallback
KINOPOISK_UNOFFICIAL_API_HOST=kinopoiskapiunofficial.tech
KINOPOISK_UNOFFICIAL_API_PORT=443
KINOPOISK_UNOFFICIAL_API_SECURE=true
KINOPOISK_UNOFFICIAL_API_KEY=

# ------------------------------------------------------------------------------
# 6. AI & SMART RECOMMENDATIONS
# ------------------------------------------------------------------------------
# AI is used to suggest similar content, analyze libraries, and generate smart tags.
AI_RECOMMENDATIONS_ENABLED=true
GEMINI_API_KEY=
AI_RECOMMENDATIONS_MODEL=gemini-3.1-flash-lite

# ------------------------------------------------------------------------------
# 7. AUTHENTICATION & SECURITY
# ------------------------------------------------------------------------------
# SuperTokens handles user login, sessions, and OAuth.
SUPERTOKENS_SERVICE_HOST=https://try.supertokens.com
SUPERTOKENS_SERVICE_PORT=443

# Google OAuth for "Sign in with Google"
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Patreon OAuth (Legacy/Optional - for linking creator accounts)
PATREON_CLIENT_ID=
PATREON_CLIENT_SECRET=

# ------------------------------------------------------------------------------
# 8. CADDY PROXY & SYSTEM CREDENTIALS
# ------------------------------------------------------------------------------
# Used by the local deployment script to bind to privileged ports (80/443).
SUDO_PASSWORD=

# DuckDNS Token for automatically updating your dynamic IP to your domain.
DUCKDNS_TOKEN=

# ------------------------------------------------------------------------------
# 9. INTERNAL MICROSERVICE PORT MAPPINGS
# ------------------------------------------------------------------------------
# ADVANCED: These ports define how the microservices communicate with each other internally.
# You generally do not need to change these unless you have port collisions with other apps on your Mac/Linux machine.

# Resolves GRPC conflicts when importing the same protobufs across different microservices.
GOLANG_PROTOBUF_REGISTRATION_CONFLICT=ignore

TORRENT_WEB_SEEDER_SERVICE_HOST=127.0.0.1
TORRENT_WEB_SEEDER_SERVICE_PORT=50054

CONTENT_TRANSCODER_SERVICE_HOST=127.0.0.1
CONTENT_TRANSCODER_SERVICE_PORT=50055

VIDEO_INFO_SERVICE_HOST=127.0.0.1
VIDEO_INFO_SERVICE_PORT=50056

TORRENT_ARCHIVER_SERVICE_HOST=127.0.0.1
TORRENT_ARCHIVER_SERVICE_PORT=50057

SRT2VTT_SERVICE_HOST=127.0.0.1
SRT2VTT_SERVICE_PORT=50058

CONTENT_PROBER_SERVICE_HOST=127.0.0.1
CONTENT_PROBER_SERVICE_PORT=50063
CONTENT_PROBER_HTTP_SERVICE_HOST=127.0.0.1
CONTENT_PROBER_HTTP_SERVICE_PORT=50062
