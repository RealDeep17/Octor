# ------------------------------------------------------------------------------
# 4. 🛠️ PERFORMANCE, STORAGE & ADVANCED TUNING
# ------------------------------------------------------------------------------

# CRITICAL: This section controls your SSD vs RAM strategy.
# WARNING: Changing between performance modes has critical data structural consequences!
#
#    Any files uploaded in Chunker mode are split into '.001', '.002', etc. slices.
#    If you switch to Non-Chunker mode, the chunker overlay is bypassed, making those
#    previously uploaded files appear as raw fragmented slices. They will be UNPLAYABLE!
#
#    Existing single-part (plain) files uploaded in Non-Chunker mode remain fully
#    readable and accessible through the chunker overlay. However, any NEW files uploaded
#    in Chunker mode will be split and will become unplayable if you switch back to sp-*!
#
# Valid Modes:
# - Chunker (pp-*): chunker-vfs-ram, chunker-vfs-ssd
# - Non-Chunker (sp-*): non-chunker-vfs-ram, non-chunker-vfs-ssd
RAM_CACHE_ENABLED=

# CRITICAL: This section controls your SSD vs RAM strategy.
# WARNING: Changing between performance modes has critical data structural consequences!
#
#    Any files uploaded in Chunker mode are split into '.001', '.002', etc. slices.
#    If you switch to Non-Chunker mode, the chunker overlay is bypassed, making those
#    previously uploaded files appear as raw fragmented slices. They will be UNPLAYABLE!
#
#    Existing single-part (plain) files uploaded in Non-Chunker mode remain fully
#    readable and accessible through the chunker overlay. However, any NEW files uploaded
#    in Chunker mode will be split and will become unplayable if you switch back to sp-*!
#
# Valid Modes:
# - Chunker (pp-*): chunker-vfs-ram, chunker-vfs-ssd
# - Non-Chunker (sp-*): non-chunker-vfs-ram, non-chunker-vfs-ssd
OCTOR_PERFORMANCE_MODE=

# Size of the memory-backed ext4 loopback image.
RAM_CACHE_SIZE=

# Size limit for the parent tmpfs RAM disk mount (/mnt/seeder-ram).
TMPFS_SIZE=

# Max local SSD/RAM space per torrent. Triggers LRU eviction if exceeded.
# Setting this LOWER (e.g. 1500M) forces active LRU eviction for large files.
PER_TORRENT_CACHE_BUDGET=

# Persistent directory on your physical SSD where files are stored when RAM mode is OFF.
SSD_DATA_DIR=

# IMPORTANT: All services use this path (Seeder, Cleaner, etc.) to read/write torrent data.
# setup-seeder-cache.sh will automatically make this either a RAM mount or a Symlink to SSD.
DATA_DIR=

# High-speed key-value store for torrent piece hashes and status.
BADGER_PATH=

# High-speed key-value store for torrent piece hashes and status.
BADGER_EXPIRE=

# Max age of inactive media in the seeder cache before deletion.
CACHED_MEDIA_MAX_AGE=

# How often the 'cleaner' background process runs to free up space.
CACHED_MEDIA_CLEAN_INTERVAL=

# Metadata/API cache lifetimes.
CACHED_METADATA_EXPIRE=

# Metadata/API cache lifetimes.
CACHE_INDEX_EXPIRE=

# Max number of torrents that can be actively vaulting (uploading to S3/Drive) at once.
# Each active vault job can hold up to PER_TORRENT_CACHE_BUDGET of data in the RAM disk.
# Lower this if you see RAM exhaustion when many torrents are queued simultaneously.
# Formula: VAULT_MAX_CONCURRENT_JOBS × PER_TORRENT_CACHE_BUDGET ≈ peak vault RAM usage.
# Set to 0 for unlimited (original behavior).
VAULT_MAX_CONCURRENT_JOBS=

# Specifies the buffer size in bytes (e.g. 33554432 for 32MB).
# This buffer bridges the high-speed seeder with the high-latency S3/Drive upload.
S3_GATEWAY_WRITE_BUFFER_SIZE=

# Temporary folder for multipart S3 uploads.
# RECOMMENDED: Use RAM Disk (/mnt/seeder-cache/s3-gateway-uploads) for zero SSD wear.
S3_GATEWAY_TEMP_UPLOADS_DIR=

# The maximum pending (unstaged) bytes allowed in RAM disk before applying backpressure.
# Default is 536870912 (512 MB).
S3_GATEWAY_MAX_STAGING_SIZE=

# Number of parallel workers uploading parts to S3/Drive.
# Increase (e.g. 8) to saturate fat pipes, but watch CPU usage.
AWS_UPLOAD_CONCURRENCY=

# Multipart part size in bytes (default 256MB). Large parts are better for Drive.
AWS_UPLOAD_PART_SIZE=

# Used by: Vault (Long-term storage) and Torrent-Store (Torrent metainfo cache).
AWS_ENDPOINT=

# Used by: Vault (Long-term storage) and Torrent-Store (Torrent metainfo cache).
AWS_REGION=

# Used by: Vault (Long-term storage) and Torrent-Store (Torrent metainfo cache).
AWS_NO_SSL=

# Multipart part size in bytes (default 256MB). Large parts are better for Drive.
# 🛑 CRITICAL WARNING: S3_GATEWAY_HUMAN_READABLE
# - If TRUE: Files are stored with torrent names. THIS BREAKS DEDUPLICATION AND
#   PREVENTS STREAMING/DOWNLOADS because files are not accessible by hash.
# - If FALSE: Files are stored by hash. This is the REQUIRED state for stability,
#   flawless streaming, and 100% storage deduplication.
S3_GATEWAY_HUMAN_READABLE=

# FORCE_DIRECT_PLAY=false (RECOMMENDED):
#   Enables "Video-Copy & Audio-Transcode" hybrid mode (PRO CHOICE).
#   - Video: Original stream is copied directly (0% CPU, 4K/1080p preserved).
#   - Audio: DTS/TrueHD is converted to AAC (for Safari/Mobile sound support).
# FORCE_DIRECT_PLAY=true:
#   Zero CPU usage, but MKV and DTS audio will not work in standard browsers.
FORCE_DIRECT_PLAY=

# Dynamic cache dir: stores VFS cache inside RAM disk when RAM_CACHE_ENABLED=true!
RCLONE_CACHE_DIR=

# Dynamic VFS Cache limits (automatically updated by switcher):
RCLONE_VFS_CACHE_MAX_SIZE=

# Dynamic VFS Cache limits (automatically updated by switcher):
RCLONE_VFS_CACHE_MODE=

# Dynamic VFS Cache limits (automatically updated by switcher):
RCLONE_VFS_CACHE_MAX_AGE=

# Dynamic VFS Cache limits (automatically updated by switcher):
RCLONE_VFS_CACHE_POLL_INTERVAL=

# Centralized RAM parameters
RCLONE_BUFFER_SIZE=

# Centralized RAM parameters
RCLONE_DRIVE_CHUNK_SIZE=

# Centralized RAM parameters
RCLONE_TRANSFERS=

# Tiered lookup: TMDB (Mainstream) -> Sidecar (Adult/Obscure) -> Kinopoisk (Foreign).
SIDECAR_ENRICHMENT_ENABLED=

# Number of days after which metadata is considered stale for the background refresh
ENRICH_REFRESH_DAYS=

# Number of days after which metadata is considered stale for the background refresh
ENRICH_CONCURRENCY=

