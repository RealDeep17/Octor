# Centralized Mount & Gateway Storage targets (automatically updated by switcher):
VAULT_STORAGE_PATH=

# Centralized Mount & Gateway Storage targets (automatically updated by switcher):
S3_GATEWAY_STORAGE_DIR=

# OCTOR COMPREHENSIVE CONFIGURATION FILE (custom.env)
# This is the master configuration file for the Octor platform. It is loaded by:
#
# PRO TIP: If you change paths here (like VAULT_STORAGE_PATH), also check the
# systemd service files in /srv/octor/ (e.g. octor-rclone-mount.service) as
# some might have hardcoded values that need to stay in sync.
#
# STORAGE CONVENTION:
#   This stack uses a "Dual-Path Storage" model for the seeder cache (DATA_DIR).
#   - RAM Mode: Mounts a high-speed ext4 loopback image in memory.
#   - SSD Mode: Symlinks DATA_DIR to a persistent folder on your SSD.
#   The 'setup-seeder-cache.sh' script handles this logic based on RAM_CACHE_ENABLED.
# These settings define the "Backing Services" that the Go microservices depend on.
# Used by: Rest-API, Vault, Abuse-Store, URL-Store, Claims-Provider.
# The init-db.sql script creates separate databases (octor, vault, abuse_store, etc.) on first boot.
POSTGRES_USER=

# OCTOR COMPREHENSIVE CONFIGURATION FILE (custom.env)
# This is the master configuration file for the Octor platform. It is loaded by:
