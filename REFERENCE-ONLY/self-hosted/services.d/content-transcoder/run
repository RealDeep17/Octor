#!/command/with-contenv /bin/sh
set -a
source /etc/webtor/common.env
WEB_PORT=$CONTENT_TRANSCODER_SERVICE_PORT
HLS_AAC_CODEC=aac
OUTPUT=$DATA_DIR
echo "[init] waiting for postgres..."
for i in $(seq 1 30); do
    if pg_isready -h ${PG_HOST:-localhost} -p ${PG_PORT:-5432} -U postgres >/dev/null 2>&1; then
        break
    fi
    sleep 1
done
set +a
/app/content-transcoder 2>&1 | s6-log p"[content-transcoder]" 1