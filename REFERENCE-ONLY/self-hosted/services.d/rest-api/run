#!/command/with-contenv /bin/sh
set -a
source /etc/webtor/common.env
EXPORT_USE_SUBDOMAINS=false
EXPORT_PATH_PREFIX=/torrent-http-proxy/
EXPORT_DOMAIN=$DOMAIN
echo "[init] waiting for postgres..."
for i in $(seq 1 30); do
    if pg_isready -h ${PG_HOST:-localhost} -p ${PG_PORT:-5432} -U postgres >/dev/null 2>&1; then
        break
    fi
    sleep 1
done
TORRENT_HTTP_PROXY_SERVICE_PORT=$WEB_PORT
TORRENT_HTTP_PROXY_SERVICE_HOST=127.0.0.1
WEB_PORT=$REST_API_SERVICE_PORT
set +a
/app/rest-api serve 2>&1 | s6-log p"[rest-api]" 1