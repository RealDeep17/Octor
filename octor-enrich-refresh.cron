#!/bin/bash
# ==============================================================================
# Octor Auto-Enrich-Refresh Weekly Maintenance Cron Job
# ==============================================================================
# Executed automatically by system cron every week to refresh stale metadata.
# Logs are appended to /var/log/octor-enrich-refresh.log
# ==============================================================================

echo -e "\n=== Auto-Enrich-Refresh Started: $(date) ===" >> /var/log/octor-enrich-refresh.log

# Run enrich refresh command as '__RUN_USER__' user via run.sh
sudo -u __RUN_USER__ __PROJECT_ROOT__/run.sh enrich refresh 7 >> /var/log/octor-enrich-refresh.log 2>&1


echo -e "=== Auto-Enrich-Refresh Finished: $(date) ===\n" >> /var/log/octor-enrich-refresh.log
