# Upstreams
upstream octor_webui {
    server 127.0.0.1:8082;
    keepalive 32;
}

upstream octor_s3_gateway {
    server 127.0.0.1:9000;
    keepalive 32;
}

upstream octor_webseed {
    server 127.0.0.1:8086;
    keepalive 32;
}

upstream octor_seeder {
    server 127.0.0.1:50052;
    keepalive 32;
}

# Redirect HTTP to HTTPS
server {
    listen 80;
    listen [::]:80;
    server_name octor.duckdns.org seedio.duckdns.org;
    return 301 https://$host$request_uri;
}

# octor.duckdns.org server block
server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name octor.duckdns.org;

    ssl_certificate /etc/letsencrypt/live/144.24.126.158/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/144.24.126.158/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers HIGH:!aNULL:!MD5;

    # Performance Tuning for Large Media / SSE Streams
    client_max_body_size 0; # Unlimited upload size
    proxy_http_version 1.1;
    proxy_set_header Connection "";
    proxy_set_header Host $http_host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;

    # Disable Buffering for all Octor locations to support real-time SSE and instant media buffering
    proxy_buffering off;
    proxy_cache off;
    proxy_read_timeout 24h;
    proxy_send_timeout 24h;

    # 1. Vault WebSeed
    location /webseed {
        proxy_pass http://octor_webseed;
        proxy_set_header X-Accel-Buffering no;
    }

    # 2. S3 Gateway
    location ^~ /vault/ {
        proxy_pass http://octor_s3_gateway;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Accel-Buffering no;
    }

    location ^~ /torrent-store/ {
        proxy_pass http://octor_s3_gateway;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Accel-Buffering no;
    }

    # 3. Seeder Services: stats, torrent metadata, etc.
    location ~* ^/(speedtest/download|torrent|stat|ext) {
        proxy_pass http://octor_seeder;
        proxy_set_header X-Accel-Buffering no;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
        
        # Disable buffering and enable keepalives for SSE stream
        chunked_transfer_encoding off;
    }

    # 4. Seeder Content: Streaming and direct downloads
    # Match infohash regex: /:infohash/... but exclude /status (routed to Web UI)
    location ~* "^/[0-9a-fA-F]{40}/.*/status$" {
        proxy_pass http://octor_webui;
        proxy_set_header X-Accel-Buffering no;
    }

    location ~* "^/[0-9a-fA-F]{40}/" {
        proxy_pass http://octor_seeder;
        proxy_set_header X-Accel-Buffering no;
    }

    # 5. Web UI: Fallback
    location / {
        proxy_pass http://octor_webui;
        proxy_set_header X-Accel-Buffering no;
    }
}

# seedio.duckdns.org server block
server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name seedio.duckdns.org;

    ssl_certificate /etc/letsencrypt/live/seedio.duckdns.org/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/seedio.duckdns.org/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers HIGH:!aNULL:!MD5;

    client_max_body_size 0;
    proxy_http_version 1.1;
    proxy_set_header Connection "";
    proxy_set_header Host $http_host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;

    proxy_buffering off;
    proxy_cache off;

    location / {
        proxy_pass http://127.0.0.1:8089;
        proxy_set_header X-Accel-Buffering no;
    }
}
