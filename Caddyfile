{
    email admin@{$DOMAIN}
    debug
}

# Local development entry point
http://localhost:8081, http://127.0.0.1:8081 {
    route {
        # 1. Route service-specific prefixes to the proxy
        @seeder_services {
            path /speedtest/download* /webseed* /torrent* /stat* /ext*
        }
        handle @seeder_services {
            reverse_proxy localhost:50052
        }

        # 2. Route torrent CONTENT (files, HLS) to the proxy
        # Matches /infohash/PATH but NOT just /infohash or /infohash/
        # ALSO EXCLUDES /infohash/status (which belongs to Web UI)
        @seeder_content {
            path_regexp ^/[0-9a-fA-F]{40}/.+
            not path */status
        }
        handle @seeder_content {
            reverse_proxy localhost:50052
        }

        # 3. Route everything else (including /infohash and /infohash/status) to the Web UI
        handle {
            reverse_proxy localhost:8082
        }
    }

    log {
        output file caddy.access.log
    }
}

# Production entry point
{$OCTOR_HOST} {
    route {
        @seeder_services {
            path /speedtest/download* /webseed* /torrent* /stat* /ext*
        }
        handle @seeder_services {
            reverse_proxy localhost:50052
        }

        @seeder_content {
            path_regexp ^/[0-9a-fA-F]{40}/.+
            not path */status
        }
        handle @seeder_content {
            reverse_proxy localhost:50052
        }

        handle {
            reverse_proxy localhost:8082
        }
    }

    tls {
        dns duckdns {$DUCKDNS_TOKEN}
    }

    log {
        output file caddy.access.log
    }
}
