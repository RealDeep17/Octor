[Unit]
Description=Octor Rclone Google Drive Union Mount
After=network.target
Before=docker.service

[Service]
Type=simple
User=ubuntu
Group=ubuntu
ExecStartPre=/usr/bin/mkdir -p /srv/octor/drive-mount
ExecStart=/usr/bin/rclone --config /home/ubuntu/.config/rclone/rclone.conf mount ALPHA_UNION: /srv/octor/drive-mount \
    --vfs-cache-mode off \
    --buffer-size 32M \
    --drive-chunk-size 32M \
    --transfers 2 \
    --allow-other \
    --umask 000
ExecStop=/usr/bin/fusermount -uz /srv/octor/drive-mount
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
