[Unit]
Description=Octor Rclone Drive1 Index Mount
After=network.target
Before=octor-s3-gateway.service

[Service]
Type=simple
User=ubuntu
Group=ubuntu
ExecStartPre=/usr/bin/mkdir -p /srv/octor/infra-data/drive1-index
ExecStart=/usr/bin/rclone --config /home/ubuntu/.config/rclone/rclone.conf mount drive1: /srv/octor/infra-data/drive1-index \
    --vfs-cache-mode off \
    --drive-use-trash=false \
    --links \
    --allow-other \
    --umask 000 --allow-non-empty
ExecStop=/usr/bin/fusermount -uz /srv/octor/infra-data/drive1-index
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
