[Unit]
Description=Octor Seeder Cache Setup (SSD or RAM ext4)
# Documentation: Set RAM_CACHE_SIZE in __PROJECT_ROOT__/custom.env to enable RAM mode
Before=octor-torrent-web-seeder.service
After=local-fs.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=__PROJECT_ROOT__/scripts/setup-seeder-cache.sh
ExecStop=__PROJECT_ROOT__/scripts/teardown-seeder-cache.sh

[Install]
WantedBy=multi-user.target
