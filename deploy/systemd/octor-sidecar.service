[Unit]
Description=Octor Sidecar
After=network.target

[Service]
Type=simple
User=__RUN_USER__
Group=__RUN_GROUP__
WorkingDirectory=__PROJECT_ROOT__/sidecar
EnvironmentFile=__PROJECT_ROOT__/custom.env
ExecStart=__PROJECT_ROOT__/bin/sidecar
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
