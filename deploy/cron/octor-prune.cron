#!/bin/bash
# ==============================================================================
# Octor Auto-Prune Weekly Maintenance Cron Job
# ==============================================================================
# Executed automatically by system cron every week to reclaim disk space.
# Logs are appended to /var/log/octor-prune.log
# ==============================================================================

echo -e "\n=== Auto-Prune Started: $(date) ===" >> /var/log/octor-prune.log

# 1. Run workspace and Go cleanups as '__RUN_USER__' user
sudo -u __RUN_USER__ __PROJECT_ROOT__/run.sh prune >> /var/log/octor-prune.log 2>&1


# 2. Clean up storage orphans from Google Drive
echo "  • Cleaning up orphaned files from Google Drive..." >> /var/log/octor-prune.log
if sudo docker ps --format '{{.Names}}' 2>/dev/null | grep -q "^octor-monolith$"; then
    docker exec -i octor-monolith /app/bin/clean_orphans --dry-run=false >> /var/log/octor-prune.log 2>&1
else
    # Hybrid mode: Run the binary on the host as __RUN_USER__ (so it has access to user environment/mount permissions)
    sudo -u __RUN_USER__ __PROJECT_ROOT__/bin/clean_orphans --dry-run=false >> /var/log/octor-prune.log 2>&1
fi

# 3. Run system-wide log cleaning as root
echo "  • System log maintenance..." >> /var/log/octor-prune.log
journalctl --vacuum-time=3d >> /var/log/octor-prune.log 2>&1


echo -e "=== Auto-Prune Finished: $(date) ===\n" >> /var/log/octor-prune.log
